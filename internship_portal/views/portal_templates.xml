<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Internship Dashboard to the Portal navigation -->
    <template id="portal_my_home_internship"
              name="Internship Portal Home Link"
              inherit_id="portal.portal_my_home">

        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">

            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <a href="/my/internship"
                   class="text-decoration-none">

                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                Internship Dashboard
                            </h5>

                            <p class="text-muted mb-0">
                                View your internship, tasks,
                                reports and supervisor feedback.
                            </p>

                        </div>
                    </div>

                </a>
            </div>

        </xpath>

    </template>


    <!-- Internship Dashboard -->
    <template id="portal_dashboard"
              name="Internship Dashboard">

        <t t-call="website.layout">

            <div id="wrap" class="oe_structure">

                <!-- Header -->
                <section class="py-5 bg-light">
                    <div class="container">

                        <div class="text-center mb-5">

                            <h1 class="fw-bold">
                                Internship Dashboard
                            </h1>

                            <p class="text-muted">
                                Welcome,
                                <span t-esc="intern.name"/>
                            </p>

                        </div>


                        <!-- Internship Information -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h3 class="mb-4">
                                    Internship Information
                                </h3>

                                <div class="row">

                                    <div class="col-md-6 mb-3">
                                        <strong>Intern:</strong>
                                        <span t-esc="intern.name"/>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Program:</strong>
                                        <span t-esc="intern.program"/>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>School:</strong>
                                        <span t-esc="intern.school"/>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Status:</strong>
                                        <span t-esc="intern.status"/>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Start Date:</strong>
                                        <span t-esc="intern.start_date"/>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>End Date:</strong>
                                        <span t-esc="intern.end_date"/>
                                    </div>

                                </div>

                                <hr/>

                                <div>

                                    <strong>
                                        Assigned Supervisor:
                                    </strong>

                                    <span t-if="supervisor">
                                        <span t-esc="supervisor.name"/>
                                    </span>

                                    <span t-else="">
                                        Not assigned
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Assigned Tasks -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h3 class="mb-4">
                                    Assigned Tasks
                                </h3>

                                <div t-if="tasks">

                                    <div t-foreach="tasks"
                                         t-as="task"
                                         class="mb-4">

                                        <div class="d-flex justify-content-between">

                                            <strong>
                                                <span t-esc="task.name"/>
                                            </strong>

                                            <span>
                                                <span t-esc="task.progress"/>
                                                %
                                            </span>

                                        </div>

                                        <p class="text-muted mb-2">
                                            <span t-esc="task.description"/>
                                        </p>

                                        <div class="progress"
                                             style="height: 20px;">

                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 t-attf-style="width: {{ task.progress }}%;">

                                                <span t-esc="task.progress"/>
                                                %

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div t-else=""
                                     class="text-muted">

                                    No tasks assigned.

                                </div>

                            </div>

                        </div>


                        <!-- Internship Reports -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h3 class="mb-4">
                                    Internship Reports
                                </h3>

                                <div t-if="reports">

                                    <div t-foreach="reports"
                                         t-as="report"
                                         class="border-bottom py-3">

                                        <strong>
                                            <span t-esc="report.name"/>
                                        </strong>

                                        <div class="text-muted">

                                            Status:
                                            <span t-esc="report.status"/>

                                        </div>

                                        <div t-if="report.submission_date"
                                             class="text-muted">

                                            Submitted:
                                            <span t-esc="report.submission_date"/>

                                        </div>

                                    </div>

                                </div>

                                <div t-else=""
                                     class="text-muted">

                                    No internship reports submitted.

                                </div>

                            </div>

                        </div>


                        <!-- Supervisor Feedback -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-body">

                                <h3 class="mb-4">
                                    Supervisor Feedback
                                </h3>

                                <div t-if="feedback">

                                    <div t-foreach="feedback"
                                         t-as="item"
                                         class="border-bottom py-3">

                                        <p class="mb-2">
                                            <span t-esc="item.comment"/>
                                        </p>

                                        <small class="text-muted">

                                            <span t-if="item.date">
                                                <span t-esc="item.date"/>
                                            </span>

                                        </small>

                                    </div>

                                </div>

                                <div t-else=""
                                     class="text-muted">

                                    No supervisor feedback available.

                                </div>

                            </div>

                        </div>

                    </div>
                </section>

            </div>

        </t>

    </template>

</odoo>