<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- INTERN ACTION                                             -->
    <!-- ========================================================= -->

    <record id="action_ims_intern" model="ir.actions.act_window">
        <field name="name">Interns</field>
        <field name="res_model">ims.intern</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- INTERN LIST VIEW                                          -->
    <!-- ========================================================= -->

    <record id="view_ims_intern_list" model="ir.ui.view">
        <field name="name">ims.intern.list</field>
        <field name="model">ims.intern</field>
        <field name="arch" type="xml">
            <list string="Interns">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="school"/>
                <field name="program"/>
                <field name="supervisor_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- INTERN FORM VIEW                                          -->
    <!-- ========================================================= -->

    <record id="view_ims_intern_form" model="ir.ui.view">
        <field name="name">ims.intern.form</field>
        <field name="model">ims.intern</field>
        <field name="arch" type="xml">
            <form string="Intern">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>

                        <group>
                            <field name="school"/>
                            <field name="program"/>

                            <!--
                                Only users belonging to the
                                Assigned Internship Supervisor group
                                can be selected.
                            -->
                            <field
                                name="supervisor_id"
                                domain="[('groups_id', 'in', [%(internship_management.group_ims_assigned_supervisor)d])]"
                            />
                        </group>
                    </group>

                    <group string="Internship Period">
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>

                        <group>
                            <field name="status"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- INTERNSHIP ACTION                                        -->
    <!-- ========================================================= -->

    <record id="action_ims_internship" model="ir.actions.act_window">
        <field name="name">Internships</field>
        <field name="res_model">ims.internship</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- INTERNSHIP LIST VIEW                                      -->
    <!-- ========================================================= -->

    <record id="view_ims_internship_list" model="ir.ui.view">
        <field name="name">ims.internship.list</field>
        <field name="model">ims.internship</field>
        <field name="arch" type="xml">
            <list string="Internships">
                <field name="name"/>
                <field name="department"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- INTERNSHIP FORM VIEW                                      -->
    <!-- ========================================================= -->

    <record id="view_ims_internship_form" model="ir.ui.view">
        <field name="name">ims.internship.form</field>
        <field name="model">ims.internship</field>
        <field name="arch" type="xml">
            <form string="Internship">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department"/>
                        </group>

                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="status"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- TASK ACTION                                               -->
    <!-- ========================================================= -->

    <record id="action_ims_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">ims.task</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- TASK LIST VIEW                                            -->
    <!-- ========================================================= -->

    <record id="view_ims_task_list" model="ir.ui.view">
        <field name="name">ims.task.list</field>
        <field name="model">ims.task</field>
        <field name="arch" type="xml">
            <list string="Tasks">
                <field name="name"/>
                <field name="intern_id"/>
                <field name="internship_id"/>
                <field name="supervisor_id"/>
                <field name="due_date"/>
                <field name="progress"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- TASK FORM VIEW                                            -->
    <!-- ========================================================= -->

    <record id="view_ims_task_form" model="ir.ui.view">
        <field name="name">ims.task.form</field>
        <field name="model">ims.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="intern_id"/>
                            <field name="internship_id"/>
                        </group>

                        <group>
                            <field name="supervisor_id"/>
                            <field name="assigned_date"/>
                            <field name="due_date"/>
                            <field name="status" readonly="1"/>
                            <field name="progress" readonly="1"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description"/>
                    </group>

                    <notebook>

                        <page string="Subtasks">
                            <field name="subtask_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="completed"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


